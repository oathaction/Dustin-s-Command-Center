{
  "title": "Pillar icons in use under 48 px",
  "date": "20261110",
  "paths_relative_to": "work/build/assets/pillar-icons/",
  "rules": {
    "screens": "DR-179: on 1x screens the pillar icons draw these pixel fits, fit B at 24 px and fit A, the only fit, at 16 px. On 2x screens a 24 px pillar icon draws its Civic Line master instead (listed under masters). The 16 px fit serves 2x screens too (D2-634).",
    "edition": "D2-497: the black edition is the one in use under 48 px. The red-black edition is kept as the record of DR-133's red placements and is not drawn in the guide.",
    "sizes": "Use each file at its own size only: 24 px files at 24 px, 16 px files at 16 px.",
    "root_attributes": "data-id is the Civic Line ID, data-size the size in px (24 or 16)."
  },
