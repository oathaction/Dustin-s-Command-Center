{
 "format": "oa-keys/1",
 "set": "c-18-masthead",
 "rule": "18.6",
 "component": "Masthead and phone menu",
 "about": "The keyboard path of this code set, walked in each live stage by the guide check. Each path starts from the component as the page first draws it, with focus on a stand-in control just before the stage. A step presses \"key\" (a KeyboardEvent key; \"Space\" is the space bar) or types \"type\"; then \"focus\" is a selector inside the stage that the focused element must match, or \"outside\"; \"states\" must hold (\"\" is the stage, \":root\" the page root); \"status\" is the exact words of the stage's role=\"status\" line, and \"status_has\" words it must contain. Written by the accessibility lead for chapter 18, Rule 18.6.",
 "paths": [
  {
   "name": "Wide: Tab through the home link and the parts; the current part says so",
   "widths": [
    1440
   ],
   "steps": [
    {
     "key": "Tab",
     "focus": ".oa-masthead-home"
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-part[aria-current=\"page\"]",
     "states": [
      {
       "el": ".oa-masthead-menu",
       "visible": false
      }
     ]
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-part:not([aria-current])"
    },
    {
     "key": "Enter",
     "focus": "[id$=\"oa-masthead-page\"]"
    }
   ]
  },
  {
   "name": "Narrow: Menu opens a modal menu at the current part; Tab moves through it; Escape and Close the menu return to Menu",
   "widths": [
    390
   ],
   "steps": [
    {
     "key": "Tab",
     "focus": ".oa-masthead-home"
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-menu",
     "states": [
      {
       "el": ".oa-masthead-menu",
       "attr": "aria-expanded",
       "is": "false"
      },
      {
       "el": ".oa-masthead-parts",
       "visible": false
      }
     ]
    },
    {
     "key": "Enter",
     "focus": ".oa-masthead-row-link[aria-current=\"page\"]",
     "states": [
      {
       "el": ".oa-masthead-menu",
       "attr": "aria-expanded",
       "is": "true"
      },
      {
       "el": ".oa-masthead-dialog",
       "prop": "open",
       "is": true
      }
     ]
    },
    {
     "key": "Escape",
     "focus": ".oa-masthead-menu",
     "states": [
      {
       "el": ".oa-masthead-menu",
       "attr": "aria-expanded",
       "is": "false"
      },
      {
       "el": ".oa-masthead-dialog",
       "prop": "open",
       "is": false
      }
     ]
    },
    {
     "key": "Space",
     "focus": ".oa-masthead-row-link[aria-current=\"page\"]",
     "states": [
      {
       "el": ".oa-masthead-dialog",
       "prop": "open",
       "is": true
      }
     ]
    },
    {
     "key": "Shift+Tab",
     "focus": ".oa-masthead-close"
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-row-link[aria-current=\"page\"]"
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-dialog .oa-masthead-row-link:not([aria-current])"
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-dialog .oa-masthead-row-link:not([aria-current])"
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-dialog .oa-masthead-row-link:not([aria-current])"
    },
    {
     "key": "Tab",
     "focus": ".oa-masthead-dialog .oa-masthead-row"
    },
    {
     "key": "Enter",
     "focus": ".oa-masthead-dialog .oa-masthead-row",
     "states": [
      {
       "el": ".oa-masthead-dialog .oa-masthead-row",
       "attr": "aria-expanded",
       "is": "true"
      },
      {
       "el": "[id$=\"oa-masthead-topics\"]",
       "visible": true
      }
     ]
    },
    {
     "key": "Tab",
     "focus": "[id$=\"oa-masthead-topics\"] .oa-masthead-row-link"
    },
    {
     "key": "Escape",
     "focus": ".oa-masthead-menu",
     "states": [
      {
       "el": ".oa-masthead-dialog",
       "prop": "open",
       "is": false
      }
     ]
    },
    {
     "key": "Enter",
     "focus": ".oa-masthead-row-link[aria-current=\"page\"]"
    },
    {
     "key": "Shift+Tab",
     "focus": ".oa-masthead-close"
    },
    {
     "key": "Enter",
     "focus": ".oa-masthead-menu",
     "states": [
      {
       "el": ".oa-masthead-dialog",
       "prop": "open",
       "is": false
      }
     ]
    }
   ]
  }
 ]
}
