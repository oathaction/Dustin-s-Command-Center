{
 "format": "oa-keys/1",
 "set": "c-18-form",
 "rule": "18.17",
 "component": "Form",
 "about": "The keyboard path of this code set, walked in each live stage by the guide check. Each path starts from the component as the page first draws it, with focus on a stand-in control just before the stage. A step presses \"key\" (a KeyboardEvent key; \"Space\" is the space bar) or types \"type\"; then \"focus\" is a selector inside the stage that the focused element must match, or \"outside\"; \"states\" must hold (\"\" is the stage, \":root\" the page root); \"status\" is the exact words of the stage's role=\"status\" line, and \"status_has\" words it must contain. Written by the accessibility lead for chapter 18, Rule 18.17.",
 "paths": [
  {
   "name": "Send with mistakes: each wrong field says so, and focus moves to the first",
   "steps": [
    {
     "key": "Tab",
     "focus": "input[autocomplete=\"email\"]"
    },
    {
     "type": "name@",
     "focus": "input[autocomplete=\"email\"]"
    },
    {
     "key": "Tab",
     "focus": "input[autocomplete=\"postal-code\"]"
    },
    {
     "type": "021",
     "focus": "input[autocomplete=\"postal-code\"]"
    },
    {
     "key": "Tab",
     "focus": ".oa-form-send"
    },
    {
     "key": "Enter",
     "focus": "input[autocomplete=\"email\"]",
     "states": [
      {
       "el": "input[autocomplete=\"email\"]",
       "attr": "aria-invalid",
       "is": "true"
      },
      {
       "el": "input[autocomplete=\"postal-code\"]",
       "attr": "aria-invalid",
       "is": "true"
      },
      {
       "el": "[id$=\"oa-form-email-error\"]",
       "visible": true
      }
     ]
    }
   ]
  },
  {
   "name": "Send right: the line says it is sending, then that it worked",
   "steps": [
    {
     "key": "Tab",
     "focus": "input[autocomplete=\"email\"]"
    },
    {
     "type": "reader@example.org",
     "focus": "input[autocomplete=\"email\"]"
    },
    {
     "key": "Tab",
     "focus": "input[autocomplete=\"postal-code\"]"
    },
    {
     "type": "12345",
     "focus": "input[autocomplete=\"postal-code\"]"
    },
    {
     "key": "Enter",
     "states": [
      {
       "el": "input[autocomplete=\"email\"]",
       "attr": "aria-invalid",
       "is": null
      },
      {
       "el": ".oa-form-send",
       "text": "Sending"
      }
     ],
     "status_has": "Sending",
     "status_el": ".oa-form-status"
    },
    {
     "states": [
      {
       "el": ".oa-form-send",
       "text": "Remind me"
      }
     ],
     "status_has": "signed up",
     "status_el": ".oa-form-status",
     "wait": 1200
    }
   ]
  }
 ]
}
