{
 "format": "oa-keys/1",
 "set": "c-18-loop-stepper",
 "rule": "18.22",
 "component": "Loop stepper",
 "about": "The keyboard path of this code set, walked in each live stage by the guide check. Each path starts from the component as the page first draws it, with focus on a stand-in control just before the stage. A step presses \"key\" (a KeyboardEvent key; \"Space\" is the space bar) or types \"type\"; then \"focus\" is a selector inside the stage that the focused element must match, or \"outside\"; \"states\" must hold (\"\" is the stage, \":root\" the page root); \"status\" is the exact words of the stage's role=\"status\" line, and \"status_has\" words it must contain. Written by the accessibility lead for chapter 18, Rule 18.22.",
 "paths": [
  {
   "name": "Step by hand; no button moves focus",
   "steps": [
    {
     "key": "Tab",
     "focus": ".oa-stepper-play"
    },
    {
     "key": "Tab",
     "focus": ".oa-stepper-reset",
     "states": [
      {
       "el": ".oa-stepper-reset",
       "attr": "aria-disabled",
       "is": "true"
      }
     ]
    },
    {
     "key": "Tab",
     "focus": ".oa-stepper-prev",
     "states": [
      {
       "el": ".oa-stepper-prev",
       "attr": "aria-disabled",
       "is": "true"
      }
     ]
    },
    {
     "key": "Tab",
     "focus": ".oa-stepper-next"
    },
    {
     "key": "Enter",
     "focus": ".oa-stepper-next",
     "states": [
      {
       "el": "[aria-current=\"step\"]",
       "visible": true
      }
     ],
     "status_has": "Step 1 of"
    },
    {
     "key": "Enter",
     "focus": ".oa-stepper-next",
     "status_has": "Step 2 of"
    },
    {
     "key": "Shift+Tab",
     "focus": ".oa-stepper-prev",
     "states": [
      {
       "el": ".oa-stepper-prev",
       "attr": "aria-disabled",
       "is": null
      }
     ]
    },
    {
     "key": "Enter",
     "focus": ".oa-stepper-prev",
     "status_has": "Step 1 of"
    }
   ]
  },
  {
   "name": "Play becomes Pause and back, with focus on it",
   "setup": {
    "reducedMotion": true
   },
   "steps": [
    {
     "key": "Tab",
     "focus": ".oa-stepper-play"
    },
    {
     "key": "Enter",
     "focus": ".oa-stepper-play",
     "states": [
      {
       "el": ".oa-stepper-play",
       "text_has": "Pause"
      }
     ]
    },
    {
     "key": "Enter",
     "focus": ".oa-stepper-play",
     "states": [
      {
       "el": ".oa-stepper-play",
       "text_has": "Play"
      }
     ]
    }
   ]
  }
 ]
}
