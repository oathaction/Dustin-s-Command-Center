  "file": "work/research/20261121_Platform-Specifications.json",
  "rows": "Array under the key 'rows', one object per application.",
  "keys": {
   "id": "channel.application, lowercase, unique, for example instagram.portrait",
   "channel": "website, substack, email, x, threads, instagram, youtube, tiktok, linkedin, video, print, slides",
   "width, height": "Numbers in 'unit'. Either may be null where the platform states only one side or none",
   "unit": "px or in",
   "aspect": "Width to height as the platform writes it, such as '1.91:1' or '4:5', or null",
   "formats": "Lowercase file types the platform accepts, or null where it states none",
   "max_bytes": "File size limit in bytes, decimal (1 MB = 1,000,000), or null",
   "safe_area": "null, or an object: {'type': 'insets', 'top', 'right', 'bottom', 'left'} in the row's unit; {'type': 'box', 'width', 'height'} centered; {'type': 'circle', 'diameter' or 'radius_pct'} centered",
   "smallest_shown_px": "The smallest size, in CSS px, at which the platform's own page says it shows the item, or null where the page does not say",
   "source": "The official page's address",
   "checked": "2026-11-21",
   "status": "read, search-result or not-found",
   "match": "exact (the export must be this size), min (this size or larger, same ratio), max (this size or smaller), or ratio (any size at the aspect)",
   "basis": "platform (the platform states it) or studio-choice (no platform governs; the studio sets it)",
   "note": "Plain words on anything a script should not assume"
  },
  "check": "A dimension script compares an export's pixel or page size to width and height by 'match'. Rows with status other than 'read' still check, and the script should print their status beside the result so a reader sees which figures rest on a search result."
 },
